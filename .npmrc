# @stylexjs/unplugin pins unplugin@^2.3.11 as a peer, but TanStack Start's
# router-plugin depends on unplugin@^3.x — a real conflict npm's default
# resolver refuses to solve. Both packages use `unplugin` only as an
# internal plugin-factory abstraction (not a shared runtime instance), so
# legacy resolution is safe here. Without this file, npm install fails on
# any host that doesn't pass --legacy-peer-deps itself (e.g. Vercel).
legacy-peer-deps=true
